---
import '../styles/global.css';
import { languages, defaultLang, type SupportedLang } from '../i18n/languages';
import { getLangFromUrl, getRouteFromUrl, getLocalizedRelativePath, getLocalizedUrl, getHreflangList, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	canonicalUrl?: string;
	ogImage?: string;
	ogType?: string;
	schema?: Record<string, any> | Array<Record<string, any>>;
	lang?: SupportedLang;
}

const currentLang: SupportedLang = Astro.props.lang || getLangFromUrl(Astro.url);
const langInfo = languages[currentLang] || languages[defaultLang];
const t = useTranslations(currentLang);

const currentRoute = getRouteFromUrl(Astro.url);
const hreflangLinks = getHreflangList(Astro.url);

const { 
  title, 
  description = "Free online gamepad tester & controller tester. Test stick drift, buttons, vibration rumble, analog triggers, and polling rate for PS5, Xbox, Switch, and PC controllers.",
  keywords = "gamepad tester, controller tester, online controller tester, xbox controller tester, ps5 controller tester, html5 gamepad tester, stick drift test, pc controller tester, gamepad tester online, windows gamepad tester, game controller tester",
  canonicalUrl = getLocalizedUrl(currentLang, Astro.url),
  ogImage = "https://controllertesters.com/og-image.png",
  ogType = "website",
  schema,
  noindex = false,
} = Astro.props;

// Determine locale code for OpenGraph
const ogLocaleMap: Record<SupportedLang, string> = {
  en: 'en_US',
  'pt-br': 'pt_BR',
  tr: 'tr_TR',
  ar: 'ar_EG',
  es: 'es_ES',
  ja: 'ja_JP',
  fr: 'fr_FR',
  de: 'de_DE',
  pt: 'pt_PT',
  ko: 'ko_KR',
  it: 'it_IT',
};
const ogLocale = ogLocaleMap[currentLang] || 'en_US';
---

<!doctype html>
<html lang={langInfo.hreflang} dir={langInfo.dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<!-- Core SEO Meta Tags -->
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Controller Testers" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Multi-Language Hreflang SEO Markup -->
		{hreflangLinks.map((item) => (
			<link rel="alternate" hreflang={item.hreflang} href={item.href} />
		))}

		<!-- OpenGraph / Facebook Meta Tags -->
		<meta property="og:site_name" content="Controller Testers" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={ogLocale} />
		
		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={title} />

		<!-- Web App / PWA Capabilities & Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=3" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
		<link rel="shortcut icon" href="/favicon.ico?v=3" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
		<meta name="apple-mobile-web-app-title" content="ControllerTesters" />
		<link rel="manifest" href="/site.webmanifest?v=3" />
		<link rel="sitemap" href="/sitemap.xml" />

		<meta name="application-name" content="ControllerTesters" />
		<meta name="theme-color" content="#000000" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- JSON-LD Structured Data Schema -->
		{schema && (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		)}
	
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XTXNMKDGDY" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-XTXNMKDGDY');
		</script>

    <!-- Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
      
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      
      window.localStorage.setItem('theme', theme);
    </script>

	</head>
	<body class="text-body antialiased flex flex-col min-h-screen bg-canvas">
    <!-- Top Navigation Header -->
    <header class="bg-canvas border-b border-hairline shrink-0 sticky top-0 z-50">
      <div class="h-[56px] sm:h-[64px] max-w-7xl mx-auto w-full flex items-center justify-between px-3 sm:px-6 gap-2">
        <!-- Logo -->
        <a href={getLocalizedRelativePath(currentLang, '/')} class="flex items-center gap-2 sm:gap-2.5 min-w-0 shrink no-underline hover:no-underline hover:opacity-90 transition-opacity select-none group" style="text-decoration: none !important;">
          <!-- SVG Logo Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" class="w-7 h-7 sm:w-8 sm:h-8 shrink-0 rounded-[7px] sm:rounded-[8px] overflow-hidden shadow-sm" fill="none">
            <defs>
              <radialGradient id="headerLogoBg" cx="50%" cy="50%" r="70%" fx="50%" fy="50%">
                <stop offset="0%" stop-color="#020024" />
                <stop offset="92%" stop-color="#1c0477" />
                <stop offset="100%" stop-color="#00d4ff" />
              </radialGradient>
            </defs>
            <rect width="600" height="600" rx="89" fill="url(#headerLogoBg)" />
            <g transform="translate(300, 300) rotate(-21) scale(18.5) translate(-12, -12)">
              <path 
                d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" 
                stroke="#c90606" 
                stroke-width="1.66" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                fill="none"
              />
              <line x1="6" x2="10" y1="11" y2="11" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="8" x2="8" y1="9" y2="13" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="15" x2="15.01" y1="12" y2="12" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="18" x2="18.01" y1="10" y2="10" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          </svg>
          <span class="font-display font-bold tracking-tight text-[15px] sm:text-[20px] md:text-[21px] decoration-transparent border-none outline-none inline-flex items-center whitespace-nowrap overflow-hidden">
            <span class="text-m-blue-dark">Controller</span><span class="text-m-blue-light">Testers</span><span class="text-m-red">.com</span>
          </span>
        </a>

        <!-- Navigation Links & Utility Actions -->
        <div class="flex items-center gap-1.5 sm:gap-4 shrink-0">
          <nav class="hidden md:flex items-center gap-6 font-display text-[12px] uppercase tracking-[1px] font-bold">
            <a 
              href={getLocalizedRelativePath(currentLang, '/')} 
              class={currentRoute === '/' ? "text-ink border-b-2 border-ink pb-1 hover:text-m-red hover:border-m-red transition-colors" : "text-muted hover:text-m-red transition-colors pb-1 border-b-2 border-transparent hover:border-m-red"}
            >
              {t('nav.diagnostics')}
            </a>
            <a 
              href={getLocalizedRelativePath(currentLang, '/stick-drift-test')} 
              class={currentRoute.startsWith('/stick-drift-test') ? "text-ink border-b-2 border-ink pb-1 hover:text-m-red hover:border-m-red transition-colors" : "text-muted hover:text-m-red transition-colors pb-1 border-b-2 border-transparent hover:border-m-red"}
            >
              {t('nav.stickDrift')}
            </a>
            <a 
              href={getLocalizedRelativePath(currentLang, '/reaction-matrix')} 
              class={currentRoute.startsWith('/reaction-matrix') || currentRoute.startsWith('/f1-reaction-time-test') ? "text-ink border-b-2 border-ink pb-1 hover:text-m-red hover:border-m-red transition-colors" : "text-muted hover:text-m-red transition-colors pb-1 border-b-2 border-transparent hover:border-m-red"}
            >
              {t('nav.reactionMatrix')}
            </a>
          </nav>
        
          <!-- Language Switcher Dropdown -->
          <div class="relative group shrink-0" id="langSwitcherContainer">
            <button 
              id="langDropdownButton" 
              class="flex items-center gap-1 sm:gap-1.5 h-7.5 sm:h-8 px-2 sm:px-2.5 bg-stone-100 hover:bg-stone-200/70 dark:bg-[#181818] dark:hover:bg-[#222222] border border-stone-200 dark:border-[#282828] hover:border-m-blue-light/50 dark:hover:border-m-blue-light/50 rounded-lg text-xs font-semibold text-ink transition-all select-none cursor-pointer shadow-xs active:scale-95 shrink-0"
              aria-label={t('lang.select')}
              title={t('lang.select')}
            >
              <span class="text-sm leading-none">{langInfo.flag}</span>
              <span class="uppercase text-[10px] sm:text-[11px] font-bold text-ink/80 group-hover:text-ink font-mono">{langInfo.code}</span>
              <svg class="w-3 sm:w-3.5 h-3 sm:h-3.5 text-muted transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>

            <!-- Language Dropdown Menu -->
            <div 
              id="langMenu"
              class="hidden group-hover:block absolute right-0 top-full pt-1.5 z-50 w-48 sm:w-52 transition-all duration-150 animate-in fade-in slide-in-from-top-1"
            >
              <div class="bg-white/95 dark:bg-[#161616]/95 backdrop-blur-md border border-stone-200 dark:border-[#282828] shadow-2xl rounded-xl p-1.5 max-h-80 overflow-y-auto">
                <div class="px-2.5 py-1 text-[9px] uppercase tracking-widest font-bold text-muted border-b border-hairline mb-1">
                  {t('lang.select')}
                </div>
                {Object.values(languages).map((item) => {
                  const targetUrl = getLocalizedRelativePath(item.code, Astro.url);
                  const isCurrent = item.code === currentLang;
                  return (
                    <a
                      href={targetUrl}
                      class={`flex items-center justify-between px-2.5 py-1.5 text-xs rounded-lg transition-colors no-underline ${
                        isCurrent
                          ? 'bg-m-blue-dark/10 dark:bg-m-blue-dark/25 text-m-blue-dark dark:text-m-blue-light font-bold'
                          : 'text-ink hover:bg-stone-100 dark:hover:bg-[#202020]'
                      }`}
                    >
                      <span class="flex items-center gap-2">
                        <span class="text-sm">{item.flag}</span>
                        <span class="font-medium">{item.nativeName}</span>
                      </span>
                      <span class="text-[10px] text-muted uppercase font-mono">{item.code}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>

          <!-- Motorsport Precision Theme Switch -->
          <button 
            id="themeToggle" 
            class="relative flex items-center h-7.5 sm:h-8 w-[50px] sm:w-[58px] bg-stone-100 hover:bg-stone-200/70 dark:bg-[#181818] dark:hover:bg-[#222222] border border-stone-200 dark:border-[#282828] hover:border-m-blue-light/50 dark:hover:border-m-red/50 p-0.5 rounded-lg transition-all duration-300 group focus:outline-none select-none cursor-pointer shadow-xs active:scale-95 shrink-0" 
            aria-label="Toggle Theme"
            title="Switch Day / Night Display Mode"
          >
            <!-- Background Track Glyphs -->
            <div class="w-full flex justify-between items-center px-1 sm:px-1.5 z-0 pointer-events-none">
              <svg class="w-2.5 sm:w-3 h-2.5 sm:h-3 text-amber-500/70 transition-colors group-hover:text-amber-500" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
              </svg>
              <svg class="w-2.5 sm:w-3 h-2.5 sm:h-3 text-stone-400 dark:text-stone-500 transition-colors dark:group-hover:text-m-blue-light" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
              </svg>
            </div>

            <!-- Sliding Tactile Thumb -->
            <div class="absolute left-0.5 dark:translate-x-[22px] sm:dark:translate-x-[26px] w-[22px] sm:w-[26px] h-[22px] sm:h-[24px] bg-white dark:bg-[#262626] rounded-md shadow-sm border border-stone-200/80 dark:border-[#383838] flex items-center justify-center transition-all duration-200 ease-out group-hover:scale-105">
              <!-- Sun (Light Mode) -->
              <svg class="w-3 sm:w-3.5 h-3 sm:h-3.5 text-amber-600 dark:hidden transition-transform duration-500 group-hover:rotate-90" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
              </svg>
              <!-- Moon (Dark Mode) -->
              <svg class="w-3 sm:w-3.5 h-3 sm:h-3.5 text-m-blue-light hidden dark:block transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
              </svg>
            </div>
          </button>

          <!-- Mobile Hamburger Toggle Button -->
          <button 
            id="mobileMenuToggle" 
            class="md:hidden flex items-center justify-center h-7.5 w-7.5 bg-stone-100 hover:bg-stone-200/70 dark:bg-[#181818] dark:hover:bg-[#222222] border border-stone-200 dark:border-[#282828] rounded-lg text-ink transition-all select-none cursor-pointer shadow-xs active:scale-95 shrink-0"
            aria-label="Toggle Navigation Menu"
            aria-expanded="false"
          >
            <!-- Hamburger Icon (3 lines) -->
            <svg id="hamburgerIcon" class="w-4 h-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <!-- Close Icon (X) -->
            <svg id="closeIcon" class="w-4 h-4 text-ink hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div 
        id="mobileMenuDrawer" 
        class="hidden md:hidden border-t border-hairline bg-surface/95 dark:bg-[#121212]/95 backdrop-blur-lg px-4 py-3 shadow-xl transition-all"
      >
        <div class="flex flex-col gap-1.5 font-display text-[13px] uppercase tracking-[1px] font-bold">
          <a 
            href={getLocalizedRelativePath(currentLang, '/')} 
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg transition-colors no-underline ${
              currentRoute === '/' 
                ? "bg-m-blue-dark/10 dark:bg-m-blue-dark/20 text-m-blue-dark dark:text-m-blue-light font-bold" 
                : "text-ink hover:bg-stone-100 dark:hover:bg-[#202020]"
            }`}
          >
            <span class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-m-blue-light"></span>
              <span>{t('nav.diagnostics')}</span>
            </span>
            <span class="text-[10px] font-mono text-muted uppercase">Home</span>
          </a>
          <a 
            href={getLocalizedRelativePath(currentLang, '/stick-drift-test')} 
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg transition-colors no-underline ${
              currentRoute.startsWith('/stick-drift-test') 
                ? "bg-m-blue-dark/10 dark:bg-m-blue-dark/20 text-m-blue-dark dark:text-m-blue-light font-bold" 
                : "text-ink hover:bg-stone-100 dark:hover:bg-[#202020]"
            }`}
          >
            <span class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-m-blue-dark"></span>
              <span>{t('nav.stickDrift')}</span>
            </span>
            <span class="text-[10px] font-mono text-muted uppercase">Drift</span>
          </a>
          <a 
            href={getLocalizedRelativePath(currentLang, '/reaction-matrix')} 
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-lg transition-colors no-underline ${
              currentRoute.startsWith('/reaction-matrix') || currentRoute.startsWith('/f1-reaction-time-test')
                ? "bg-m-blue-dark/10 dark:bg-m-blue-dark/20 text-m-blue-dark dark:text-m-blue-light font-bold" 
                : "text-ink hover:bg-stone-100 dark:hover:bg-[#202020]"
            }`}
          >
            <span class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-m-red"></span>
              <span>{t('nav.reactionMatrix')}</span>
            </span>
            <span class="text-[10px] font-mono text-muted uppercase">Reflex</span>
          </a>
        </div>
      </div>
    </header>

		<main class="flex-1 w-full flex flex-col items-center px-4 sm:px-6 py-2 sm:py-3">
			<div class="max-w-7xl w-full flex flex-col">
				<slot />
			</div>
		</main>
	
    <!-- Global Multilingual Footer -->
    <footer class="w-full bg-surface border-t border-hairline mt-12 py-10 px-4 sm:px-6 text-sm">
      <div class="max-w-7xl mx-auto flex flex-col gap-8">
        <!-- Top Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <div class="flex items-center gap-2.5 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" class="w-6 h-6 shrink-0 rounded-[6px] overflow-hidden shadow-sm" fill="none">
                <defs>
                  <radialGradient id="footerLogoBg" cx="50%" cy="50%" r="70%" fx="50%" fy="50%">
                    <stop offset="0%" stop-color="#020024" />
                    <stop offset="92%" stop-color="#1c0477" />
                    <stop offset="100%" stop-color="#00d4ff" />
                  </radialGradient>
                </defs>
                <rect width="600" height="600" rx="89" fill="url(#footerLogoBg)" />
                <g transform="translate(300, 300) rotate(-21) scale(18.5) translate(-12, -12)">
                  <path 
                    d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" 
                    stroke="#c90606" 
                    stroke-width="1.66" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    fill="none"
                  />
                  <line x1="6" x2="10" y1="11" y2="11" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="8" x2="8" y1="9" y2="13" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="15" x2="15.01" y1="12" y2="12" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
                  <line x1="18" x2="18.01" y1="10" y2="10" stroke="#c90606" stroke-width="1.66" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              </svg>
              <span class="font-display font-bold text-lg">
                <span class="text-m-blue-dark">Controller</span><span class="text-m-blue-light">Testers</span><span class="text-m-red">.com</span>
              </span>
            </div>
            <p class="text-xs text-muted max-w-lg">
              {t('footer.tagline')}
            </p>
          </div>

          <!-- Quick Navigation Links -->
          <div class="flex flex-col sm:items-end gap-3">
            <nav class="flex flex-wrap gap-4 sm:gap-6 text-xs font-display uppercase tracking-wider font-bold">
              <a href={getLocalizedRelativePath(currentLang, '/')} class="text-muted hover:text-ink transition-colors no-underline">
                {t('nav.diagnostics')}
              </a>
              <a href={getLocalizedRelativePath(currentLang, '/stick-drift-test')} class="text-muted hover:text-ink transition-colors no-underline">
                {t('nav.stickDrift')}
              </a>
              <a href={getLocalizedRelativePath(currentLang, '/reaction-matrix')} class="text-muted hover:text-ink transition-colors no-underline">
                {t('nav.reactionMatrix')}
              </a>
              <a href={getLocalizedRelativePath(currentLang, '/f1-reaction-time-test')} class="text-muted hover:text-ink transition-colors no-underline">
                {t('nav.f1Reaction')}
              </a>
            </nav>
            <nav class="flex flex-wrap gap-2.5 sm:gap-4 text-[11px] font-sans text-muted">
              <a href={getLocalizedRelativePath(currentLang, '/about')} class="hover:text-ink transition-colors no-underline">
                {t('footer.about')}
              </a>
              <span>•</span>
              <a href={getLocalizedRelativePath(currentLang, '/contact')} class="hover:text-ink transition-colors no-underline">
                {t('footer.contact')}
              </a>
              <span>•</span>
              <a href={getLocalizedRelativePath(currentLang, '/privacy-policy')} class="hover:text-ink transition-colors no-underline">
                {t('footer.privacy')}
              </a>
              <span>•</span>
              <a href={getLocalizedRelativePath(currentLang, '/terms')} class="hover:text-ink transition-colors no-underline">
                {t('footer.terms')}
              </a>
            </nav>
          </div>
        </div>

        <!-- Language Regional Editions Bar for Multilingual SEO -->
        <div class="pt-6 border-t border-hairline flex flex-col gap-3">
          <div class="text-[10px] font-display uppercase tracking-widest font-bold text-muted">
            {t('footer.languages')}
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs">
            {Object.values(languages).map((item) => {
              const targetUrl = getLocalizedRelativePath(item.code, Astro.url);
              const isCurrent = item.code === currentLang;
              return (
                <a
                  href={targetUrl}
                  class={`inline-flex items-center gap-1.5 no-underline transition-colors ${
                    isCurrent
                      ? 'text-m-blue-dark dark:text-m-blue-light font-bold underline decoration-m-blue-dark/50'
                      : 'text-muted hover:text-ink hover:underline'
                  }`}
                  hreflang={item.hreflang}
                >
                  <span class="text-sm">{item.flag}</span>
                  <span>{item.nativeName}</span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Copyright -->
        <div class="pt-4 border-t border-hairline flex flex-col sm:flex-row justify-between items-center text-[11px] text-muted gap-2">
          <div>
            &copy; {new Date().getFullYear()} ControllerTesters.com. {t('footer.rights')}
          </div>
          <div class="flex gap-4">
            <span>W3C HTML5 Gamepad API Telemetry</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scripts for Theme & Language Dropdown -->
    <script>
      const themeToggle = document.getElementById('themeToggle');
      
      const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      }

      themeToggle?.addEventListener("click", handleToggleClick);

      // Interactive Click Support for Language Switcher (for touch & click)
      const langBtn = document.getElementById('langDropdownButton');
      const langMenu = document.getElementById('langMenu');
      const langContainer = document.getElementById('langSwitcherContainer');

      langBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        langMenu?.classList.toggle('hidden');
      });

      // Mobile Navigation Drawer Toggle
      const mobileMenuToggle = document.getElementById('mobileMenuToggle');
      const mobileMenuDrawer = document.getElementById('mobileMenuDrawer');
      const hamburgerIcon = document.getElementById('hamburgerIcon');
      const closeIcon = document.getElementById('closeIcon');

      mobileMenuToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = mobileMenuDrawer?.classList.toggle('hidden');
        if (isHidden) {
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          mobileMenuToggle.setAttribute('aria-expanded', 'false');
        } else {
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
          mobileMenuToggle.setAttribute('aria-expanded', 'true');
        }
      });

      document.addEventListener('click', (e) => {
        if (!langContainer?.contains(e.target as Node)) {
          langMenu?.classList.add('hidden');
        }
        if (!mobileMenuDrawer?.contains(e.target as Node) && !mobileMenuToggle?.contains(e.target as Node)) {
          mobileMenuDrawer?.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
          mobileMenuToggle?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>

	</body>
</html>
